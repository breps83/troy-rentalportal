@using RentalPortal.Web.Enums
@model ApplicationFormViewModel
@{
    ViewData["Title"] = $"Application for {Model.PropertyName} – Unit {Model.UnitNumber}";

    // Bootstrap badge color per status; terminal statuses use muted or outcome colors.
    var statusBadge = Model.Status switch
    {
        ApplicationStatus.Draft => "text-bg-secondary",
        ApplicationStatus.Submitted => "text-bg-primary",
        ApplicationStatus.Returned => "text-bg-warning",
        ApplicationStatus.Approved => "text-bg-success",
        ApplicationStatus.Denied => "text-bg-danger",
        _ => "text-bg-light border"
    };

    var current = Model.CurrentSection;
    var sectionEditable = Model.IsSectionEditable(current);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Listings" asp-action="Index">Available Units</a></li>
        <li class="breadcrumb-item active" aria-current="page">Application</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-0">@Model.PropertyName – Unit @Model.UnitNumber</h1>
        <div class="text-muted">@Model.MonthlyRent.ToString("C0") per month</div>
    </div>
    <span class="badge fs-6 @statusBadge">@Model.Status</span>
</div>

<ol class="list-group list-group-horizontal-md mb-4">
    @foreach (var step in Enum.GetValues<ApplicationSection>())
    {
        <li class="list-group-item flex-fill @(step == current ? "active" : "")"
            aria-current="@(step == current ? "step" : null)">
            @step.Title()
            @if (Model.IsSectionCompleted(step))
            {
                <span class="ms-1" aria-label="saved">✓</span>
            }
        </li>
    }
</ol>

<form asp-action="Details" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="CurrentSection" />

    <div class="card mb-3">
        <div class="card-header fw-semibold">@current.Title()</div>
        <div class="card-body">

            @switch (current)
            {
                case ApplicationSection.Info:
                   
                    <partial name="_ApplicantInfo" for="ApplicantInfo" />
                    break;

                case ApplicationSection.ResidenceHistory:
                 
                   <div id="residence-history">
                        @await Component.InvokeAsync("ResidenceHistory", 
                            new{applicationId = Model.Id, editable = Model.IsSectionEditable(current)})
                   </div>
                    break;

                case ApplicationSection.Summary:
                   
                    <h2 class="h6">@ApplicationSection.Info.Title()</h2>

                    <partial name="_ApplicantInfo" for="ApplicantInfo" />

                    <h2 class="h6">@ApplicationSection.ResidenceHistory.Title()</h2>

                    @await Component.InvokeAsync("ResidenceHistory",
                        new { applicationId = Model.Id, editable = false })

                    break;
            }
        </div>
    </div>

    <div class="d-flex justify-content-between">

        @if (current != ApplicationSection.Info)
        {
            <button type="submit" class="btn btn-outline-secondary" formnovalidate
                    name="command" value="@ApplicationFormViewModel.Back">Back</button>
        }
        else
        {
            <span></span>
        }

        
        @if (sectionEditable && current != ApplicationSection.Summary)
        {
            <button type="submit" class="btn btn-primary"
                    name="command" value="@ApplicationFormViewModel.Continue">Continue</button>
        }

        @if (current == ApplicationSection.Summary && Model.CanSubmit)
        {
            <button type="submit" class="btn btn-success" id="submit-application"
                    name="command" value="@ApplicationFormViewModel.Submit">Submit</button>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Disable Submit after the first click so a double-click doesn't post twice.
        document.addEventListener('submit', function (event) {
            if (event.submitter && event.submitter.id === 'submit-application') {
                setTimeout(function () { event.submitter.disabled = true; });
            }
        });
    </script>
}
