@model ApplicationFormViewModel
@{
    ViewData["Title"] = $"Application for {Model.PropertyName} – Unit {Model.UnitNumber}";

    var current = Model.CurrentSection;
    var sectionEditable = Model.IsSectionEditable(current);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Applications" asp-action="Index">
                @(User.IsPropertyManager() ? "Applications" : "My Applications")
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            Application
        </li>
    </ol>
</nav>

<div class="row g-3 align-items-center mb-4">
    <div class="col-md-7 col-lg-8">
        <h1 class="h3 mb-0">@Model.PropertyName – Unit @Model.UnitNumber</h1>
        <div class="text-muted">@Model.MonthlyRent.ToString("C0") per month</div>

        @if (Model.CanWithdraw)
        {
            <button type="button" class="btn btn-outline-danger mt-2"
                    data-modal-url="@Url.Action("Withdraw", new { id = Model.Id })">
                Withdraw application
            </button>
        }
    </div>
    <div class="col-md-5 col-lg-4" id="application-status">
        @await Component.InvokeAsync("ApplicationStatus", new { applicationId = Model.Id })
    </div>
</div>

<ol class="list-group list-group-horizontal-md mb-4">
    @foreach (var step in Enum.GetValues<ApplicationSection>())
    {
        <li class="list-group-item flex-fill @(step == current ? "active" : "")"
            aria-current="@(step == current ? "step" : null)">
            @step.Title()
            @if (Model.IsSectionCompleted(step))
            {
                <span class="ms-1" aria-label="saved">✓</span>
            }
        </li>
    }
</ol>

<form asp-action="Details" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="CurrentSection" />

    <div class="card mb-3">
        <div class="card-header fw-semibold">@current.Title()</div>
        <div class="card-body">

            @switch (current)
            {
                case ApplicationSection.Info:
                   
                    <partial name="_ApplicantInfo" for="ApplicantInfo" />
                    break;

                case ApplicationSection.ResidenceHistory:
                 
                    <div id="residence-history">
                        @await Component.InvokeAsync("ResidenceHistory",
                            new { applicationId = Model.Id, editable = Model.IsSectionEditable(current) })
                    </div>
                    break;

                case ApplicationSection.Summary:
                   
                    <h2 class="h6">@ApplicationSection.Info.Title()</h2>

                    <partial name="_ApplicantInfo" for="ApplicantInfo" />

                    <h2 class="h6">@ApplicationSection.ResidenceHistory.Title()</h2>

                    @await Component.InvokeAsync("ResidenceHistory",
                        new { applicationId = Model.Id, editable = false })

                    break;
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">

        @if (sectionEditable && current != ApplicationSection.Info)
        {
            <button type="submit" class="btn btn-outline-secondary" formnovalidate
                    name="command" value="@ApplicationFormViewModel.Back">
                Back
            </button>
        }


        @if (sectionEditable && current != ApplicationSection.Summary)
        {
            <button type="submit" class="btn btn-primary"
                    name="command" value="@ApplicationFormViewModel.Continue">
                Continue
            </button>
        }

        @if (current == ApplicationSection.Summary && Model.CanSubmit)
        {
            <button type="submit" class="btn btn-success" id="submit-application" data-disable-on-submit
                    name="command" value="@ApplicationFormViewModel.Submit">
                Submit
            </button>
        }
    </div>
</form>

@if (!Model.IsEditable)
{
    <div class="d-flex justify-content-end gap-2">
        @if (current != ApplicationSection.Info)
        {
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               asp-route-section="@current.PreviousSection()"
               class="btn btn-outline-secondary">Previous</a>
        }
        @if (current != ApplicationSection.Summary)
        {
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               asp-route-section="@current.NextSection()"
               class="btn btn-outline-primary">Next</a>
        }
    </div>

    <div id="application-history">
        @await Component.InvokeAsync("ApplicationHistory", new { applicationId = Model.Id })
    </div>
}

@section Scripts {

    <partial name="_ValidationScriptsPartial" />
}
