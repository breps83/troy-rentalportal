@model ApplicationListViewModel
@{
    var isManager = User.IsPropertyManager();

    ViewData["Title"] = "Applications";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="Index" method="get" class="card card-body flex-grow-0 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-4">
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-select"
                    asp-items="Html.GetEnumSelectList<ApplicationStatus>()
                        .Select(i => new SelectListItem(
                                        i.Text,
                                        i.Text,
                                        i.Text == Model.Status?.ToString()))">
<option value="">All statuses</option>
</select>
        </div>
        <div class="col-sm-4">
            <label for="propertyId" class="form-label">Property</label>
            <select id="propertyId" name="propertyId" class="form-select"
                    asp-items="Model.Properties.Select(p => new SelectListItem(
                                                                p.Text,
                                                                p.Value,
                                                                p.Value == Model.PropertyId?.ToString()))">
<option value="">All properties</option>
</select>
        </div>
        <div class="col-sm-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (Model.Applications.Count == 0)
{
    <div class="alert alert-light border">
        
        There are no applications that match these filters.

        @if (!isManager)
        {
            <a asp-controller="Listings" asp-action="Index">Browse available units</a>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Property / Unit</th>
                        @if (isManager)
                        {
                            <th>Applicant</th>
                        }
                        <th>Status</th>
                        <th>Started</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var application in Model.Applications)
                    {
                        <tr>
                            <td>@application.Id</td>
                            <td>@application.PropertyName &middot; Unit @application.UnitNumber</td>
                            @if (isManager)
                            {
                                <td>@application.ApplicantName</td>
                            }
                            <td><partial name="_ApplicationStatus" model="application.Status" /></td>
                            <td>@application.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td>@(application.SubmittedAtUtc?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@application.Id" class="btn btn-sm btn-outline-primary">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}