@model ApplicantInfoViewModel
@{
    var editable = Model.IsEditable;
}

@if (editable)
{
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" autocomplete="tel" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="CurrentAddress" class="form-label"></label>
            <input asp-for="CurrentAddress" class="form-control" autocomplete="street-address" />
            <span asp-validation-for="CurrentAddress" class="text-danger small"></span>
        </div>
    </div>
}
else
{
    <dl class="row mb-0">
        <dt class="col-sm-3 fw-normal text-muted">Name</dt>
        <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>
        <dt class="col-sm-3 fw-normal text-muted"><label asp-for="Phone"></label></dt>
        <dd class="col-sm-9">@Model.Phone</dd>
        <dt class="col-sm-3 fw-normal text-muted"><label asp-for="Email"></label></dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3 fw-normal text-muted"><label asp-for="CurrentAddress"></label></dt>
        <dd class="col-sm-9">@Model.CurrentAddress</dd>
    </dl>
}
