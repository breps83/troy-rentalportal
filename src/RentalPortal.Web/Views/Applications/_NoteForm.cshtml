@model ApplicationNoteFormViewModel
@{
    var isNew = Model.NoteId == null;
}

<form asp-controller="Applications" asp-action="@(isNew ? "AddNote" : "EditNote")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(isNew ? "Add note" : "Edit note")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="ApplicationId" />
        <input type="hidden" asp-for="NoteId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <label asp-for="Note" class="form-label"></label>
        <span class="badge text-bg-warning ms-1">Not visible to the applicant</span>
        <textarea asp-for="Note" rows="5" class="form-control"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
