@using RentalPortal.Web.Enums
@model ReviewViewModel

<form asp-controller="Applications" asp-action="Review" method="post">
    <div class="modal-header">
        <h5 class="modal-title">Review application</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="ApplicationId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @if (Model.CanReview)
        {
            <div class="mb-3">
                <label asp-for="ReviewStatus" class="form-label">Decision</label>
                <select asp-for="ReviewStatus" asp-items="Html.GetEnumSelectList<ApplicationReviewStatus>()"
                        class="form-select">
                    <option value="">Select a decision</option>
                </select>
                <span asp-validation-for="ReviewStatus" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" rows="4" class="form-control"></textarea>
                <div class="form-text">Required when returning or denying the application.</div>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="mt-3 p-3 border border-warning-subtle rounded bg-warning-subtle">
                <label asp-for="InternalNote" class="form-label"></label>
                <span class="badge text-bg-warning ms-1">Not visible to the applicant</span>
                <textarea asp-for="InternalNote" rows="3" class="form-control"></textarea>
                <div class="form-text">Optional. Saved to the application's internal notes.</div>
                <span asp-validation-for="InternalNote" class="text-danger"></span>
            </div>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            @(Model.CanReview ? "Cancel" : "Close")
        </button>
        @if (Model.CanReview)
        {
            <button type="submit" class="btn btn-primary">Save</button>
        }
    </div>
</form>
