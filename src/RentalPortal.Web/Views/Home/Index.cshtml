@using RentalPortal.Web.Domain
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4 mb-3">Welcome to RentalPortal</h1>
    <p class="lead mb-4">
        Looking for your next home? Browse available rentals and apply online in minutes.
        Managing properties? List your units, review applications, and keep everything in one place.
    </p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="mb-4">Welcome back, @User.Identity.Name!</p>

        @* Same order and names as the navbar (Views/Shared/_Layout.cshtml). *@
        <div class="d-flex justify-content-center flex-wrap gap-2">
            @if (User.IsInRole(Roles.PropertyManager))
            {
                <a asp-controller="Properties" asp-action="Index" class="btn btn-primary btn-lg">Manage Properties</a>
                <a asp-controller="Listings" asp-action="Index" class="btn btn-outline-primary btn-lg">Browse Available Units</a>
            }
            else
            {
                <a asp-controller="Listings" asp-action="Index" class="btn btn-primary btn-lg">Browse Available Units</a>
            }
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Register</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">Log in</a>
        </div>
        <p class="text-muted mt-3 mb-0">New here? Creating an account only takes a minute.</p>
    }
</div>
