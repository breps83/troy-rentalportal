@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4 mb-3">Welcome to Rental Portal</h1>
    
    @if (User.IsInRole(Roles.Applicant))
    {
        <p class="lead mb-4">
            Browse available rentals and apply online in minutes.
        </p>
    }

    @if (User.IsInRole(Roles.PropertyManager))
    {
        <p class="lead mb-4">
            List your units, review applications, and keep everything in one place.
        </p>
    }

    <div class="d-flex justify-content-center flex-wrap gap-2">
        @if (User.IsInRole(Roles.PropertyManager))
        {
            <a asp-controller="Properties" asp-action="Index" class="btn btn-primary btn-lg">Manage Properties</a>
            <a asp-controller="Listings" asp-action="Index" class="btn btn-primary btn-lg">Browse Available Units</a>
        }
        else
        {
            <a asp-controller="Listings" asp-action="Index" class="btn btn-primary btn-lg">Browse Available Units</a>
        }

        @if (User.IsInRole(Roles.PropertyManager))
        {
            <a asp-controller="Applications" asp-action="Index" class="btn btn-primary btn-lg">Applications</a>
        }
        @if (User.IsInRole(Roles.Applicant))
        {
            <a asp-controller="Applications" asp-action="Index" class="btn btn-success btn-lg">My Applications</a>
        }
    </div>
</div>
