@model IReadOnlyList<AvailableUnitViewModel>
@{
    ViewData["Title"] = "Available Units";

    // group by property & address for display only.
    var properties = Model.GroupBy(u => new { u.PropertyName, u.Address });

    var canApply = User.IsApplicant();

    var columnCount = canApply ? 5 : 4;
}

<h1 class="h3 mb-4">Available Units</h1>

@if (!Model.Any())
{
    <div class="alert alert-light border">There are no units available right now. Please check back later.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Unit</th>
                    <th scope="col">Type</th>
                    <th scope="col" class="text-center">Bedrooms</th>
                    <th scope="col" class="text-center">Monthly rent</th>
                    @if (canApply)
                    {
                        <th scope="col" style="width: 1%"><span class="visually-hidden">Apply</span></th>
                    }
                </tr>
            </thead>
            @foreach (var property in properties)
            {
                <tbody>
                    <tr class="table-light">
                        <th scope="rowgroup" colspan="@columnCount" class="pt-3">
                            <span class="fw-semibold">@property.Key.PropertyName</span>
                            <span class="text-muted fw-normal ms-2">@property.Key.Address</span>
                        </th>
                    </tr>
                    @foreach (var unit in property)
                    {
                        <tr>
                            <td>@unit.UnitNumber</td>
                            <td>@unit.UnitType</td>
                            <td class="text-center">@(unit.Bedrooms == 0 ? "Studio" : unit.Bedrooms.ToString())</td>
                            <td class="text-center">@unit.MonthlyRent.ToString("C0")</td>
                            @if (canApply)
                            {
                                <td class="text-end text-nowrap">
                                    <form asp-controller="Applications" asp-action="Apply"
                                          asp-route-unitId="@unit.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-primary">Apply for Unit</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
