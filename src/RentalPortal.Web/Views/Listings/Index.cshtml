@model IReadOnlyList<AvailableUnitViewModel>
@{
    ViewData["Title"] = "Available Units";

    // group by property & address for display only.
    var properties = Model.GroupBy(u => new { u.PropertyName, u.Address });

    var canApply = User.IsApplicant();

    var propertyManager = User.IsPropertyManager();

    var columnCount = 4;
    if (canApply)
    {
        columnCount++;
    }
    if (propertyManager)
    {
        columnCount++;
    }
}

<h1 class="h3 mb-4">Available Units</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">There are no units available right now. Please check back later.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Unit</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-center">Bedrooms</th>
                        <th scope="col" class="text-center">Monthly rent</th>
                        @if (canApply)
                        {
                            <th scope="col" class="col-fit"><span class="visually-hidden">Apply</span></th>
                        }
                        @if (propertyManager)
                        {
                            <th scope="col" class="col-fit"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                @foreach (var property in properties)
                {
                    <tbody>
                        <tr class="table-light">
                            <th scope="rowgroup" colspan="@columnCount" class="pt-3">
                                <span class="fw-semibold">@property.Key.PropertyName</span>
                                <span class="text-muted fw-normal ms-2">@property.Key.Address</span>
                            </th>
                        </tr>
                        @foreach (var unit in property)
                        {
                            <tr>
                                <td>@unit.UnitNumber</td>
                                <td>
                                    @unit.UnitType                                   
                                    @if (propertyManager && !unit.UnitTypeIsActive)
                                    {
                                        <span class="badge text-bg-light border ms-1">inactive</span>
                                    }
                                </td>
                                <td class="text-center">@(unit.Bedrooms == 0 ? "Studio" : unit.Bedrooms.ToString())</td>
                                <td class="text-center">@unit.MonthlyRent.ToString("C0")</td>
                                @if (canApply)
                                {
                                    <td class="text-end text-nowrap">
                                        <form asp-controller="Applications" asp-action="Apply"
                                              asp-route-unitId="@unit.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-primary" data-disable-on-submit>
                                                Apply for Unit
                                            </button>
                                        </form>
                                    </td>
                                }
                                @if (propertyManager)
                                {
                                    @* No refresh target: site.js reloads the page after a save. *@
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-modal-url="@Url.Action("Edit", "Units", new { id = unit.Id })">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-modal-url="@Url.Action("Delete", "Units", new { id = unit.Id })">
                                            Delete
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    </div>
}
