@model IReadOnlyList<PropertyRowViewModel>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p>No properties have been added yet.</p>
        <button type="button" class="btn btn-outline-primary"
                data-modal-url="@Url.Action("Create")"
                data-refresh-url="@Url.Action("List")"
                data-refresh-target="#property-list">
            Add your first property
        </button>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Address</th>
                    <th scope="col">Units</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@property.Id">@property.Name</a></td>
                        <td>@property.Address</td>
                        <td class="text-center">@property.UnitCount</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@property.Id">View Units</a>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-modal-url="@Url.Action("Edit", new { id = property.Id })"
                                    data-refresh-url="@Url.Action("List")"
                                    data-refresh-target="#property-list">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-modal-url="@Url.Action("Delete", new { id = property.Id })"
                                    data-refresh-url="@Url.Action("List")"
                                    data-refresh-target="#property-list">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}