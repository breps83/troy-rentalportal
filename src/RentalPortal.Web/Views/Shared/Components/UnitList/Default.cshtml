@model UnitListViewModel
@{
    var refreshUrl = Url.Action("List", "Units", new { propertyId = Model.PropertyId });
}

@if (!Model.Units.Any())
{
    <div class="alert alert-light border">This property doesn't have any units yet.</div>
}
else
{
    <div class="card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>Type</th>
                    <th class="text-center">Bedrooms</th>
                    <th class="text-end">Monthly rent</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <td class="fw-semibold">@unit.UnitNumber</td>
                        <td>
                            @unit.UnitType
                            @if (!unit.UnitTypeIsActive)
                            {
                                <span class="badge text-bg-light border ms-1">inactive</span>
                            }
                        </td>
                        <td class="text-center">@(unit.Bedrooms == 0 ? "Studio" : unit.Bedrooms)</td>
                        <td class="text-end">@unit.MonthlyRent.ToString("C0")</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-modal-url="@Url.Action("Edit", "Units", new { id = unit.Id })"
                                    data-refresh-url="@refreshUrl"
                                    data-refresh-target="#unit-list">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-modal-url="@Url.Action("Delete", "Units", new { id = unit.Id })"
                                    data-refresh-url="@refreshUrl"
                                    data-refresh-target="#unit-list">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}