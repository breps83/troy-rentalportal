@model ConfirmDeleteViewModel
<form action="@Model.ActionUrl" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@Model.Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger mb-0">@Model.Error</div>
        }
        else
        {
            <p class="mb-0">@Model.Message</p>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        @if (Model.Error is null)
        {
            <button type="submit" class="btn btn-danger">Remove</button>
        }
    </div>
    @Html.AntiForgeryToken()
</form>