@model UnitFormViewModel
@{
    var isNew = Model.Id == 0;
}
<form asp-controller="Units" asp-action="@(isNew ? "Create" : "Edit")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(isNew ? "Add unit" : $"Edit unit {Model.UnitNumber}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PropertyId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="UnitNumber" class="form-label"></label>
                <input asp-for="UnitNumber" class="form-control" />
                <span asp-validation-for="UnitNumber" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="UnitTypeId" class="form-label"></label>
                <select asp-for="UnitTypeId" asp-items="Model.UnitTypes" class="form-select">
                    <option value="">Select a type</option>
                </select>
                <span asp-validation-for="UnitTypeId" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" type="number" min="0" max="10" class="form-control" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="MonthlyRent" type="number" min="1" max="100000" step="0.01" class="form-control" />
                </div>
                <span asp-validation-for="MonthlyRent" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>